# ──────────────────────────────────────────────────────────────
# VaneAI · environment variables (template)
# Copy to .env.local and fill in. NEVER commit real values.
# Source of truth: docs/03-environments.md §环境变量管理
# ──────────────────────────────────────────────────────────────

# Site (used to build OAuth redirect URIs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — `supabase start` prints these locally
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider — fal.ai (optional in milestone #1; required from milestone #2)
FAL_API_KEY=

# Inngest (optional in milestone #1; required from milestone #2)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (optional)
SENTRY_DSN=

# Authorization
# Comma-separated list of admin emails for the (admin) route group
ADMIN_EMAILS=

# Local guardrail to prevent runaway provider calls during dev
DAILY_DEV_CALL_LIMIT=20
